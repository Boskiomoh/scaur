    },
    {
      "name": "shop-tablet",
      "path": "/shop",
      "reference": "design/frames/TabletCollection.png"
    },
    {
      "name": "shop-phone",
      "path": "/shop",
      "reference": "design/frames/MobileCollection.png"
    },
    {
